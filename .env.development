# 开发环境
#NODE_ENV = 'development'
VITE_ENV = 'development'
VITE_BASE_URL = 'http://127.0.0.1:9003/'
VITE_BASE_PREFIX = '/'
# 上传图片的格式
VITE_ACCEPT = 'image/jpeg,image/png'
# 上传图片的大小，单位为 M
VITE_IMAGE_SIZE = 2
# 上传图片的最大最小像素值
VITE_MAX_WIDTH = 2048
VITE_MAX_HEIGHT = 2048
VITE_MIN_WIDTH = 800
VITE_MIN_HEIGHT = 800
# 自定义命名时记得前面加个“VITE_”
# 区分字眼是供应连true还是大投供应链false
VITE_PERMISSION = "true" 